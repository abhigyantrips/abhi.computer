---
import ComputerLayout from "@/layouts/computer-layout.astro";
---

<ComputerLayout
	appId="colophon"
	title="Colophon"
	description="The artists and resources behind this computer."
>
	<div class="flex flex-col gap-4 p-8">
		<p>
			Application icons, the launcher icon, and cursor artwork are from <a
				href="https://www.streamlinehq.com/icons/plump-remix-free">Plump Remix Free by Streamline</a
			>, licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
		</p>
		<p>
			The cursor artwork has been resized, padded, and given an opaque white interior and a white
			outline for contrast. Application icon paths are unmodified. Minimize and close are original
			interface glyphs.
		</p>
	</div>
</ComputerLayout>
